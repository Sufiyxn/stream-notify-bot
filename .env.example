# ---------------------------------------------------------------------------
# Secrets for the Stream Notifier bot. Copy this file to ".env" and fill it in.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# Required: your Discord bot token (Developer Portal -> Bot -> Token)
DISCORD_TOKEN=

# YouTube (optional but recommended): a YouTube Data API v3 key.
# Without it the bot falls back to scraping the channel /live page.
YOUTUBE_API_KEY=

# Twitch (required only if you set twitch_username in config.json):
# Create an application at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: deliver notifications through a Discord webhook instead of the bot
# user. Required only when "webhook_mode": true in config.json.
DISCORD_WEBHOOK_URL=
